# Copy this file to .env and fill in whichever keys you have.
# chat_with_fallback() skips any provider whose key is missing — you
# don't need all of these, just at least one for the agent to run.

# Groq — free tier, no card required. https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — free ":free"-suffixed models. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini — free tier. https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=

# Fireworks.ai — recommended for testing: $1 free credit, no card needed
# at signup. https://fireworks.ai/api-keys
FIREWORKS_API_KEY=

# Cerebras Cloud — fastest tokens/sec, but requires a verified card and
# has tighter rate limits on the trial tier. Optional.
# https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
